# Copiar este archivo como .env y completar los valores reales.
# NUNCA commitear el .env real (ya está en .gitignore).

# Local / desarrollo: SQLite en un archivo, no requiere nada instalado.
# Producción (Neon): postgresql+asyncpg://usuario:password@ep-xxx.neon.tech/dbname
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Generar una clave larga y random, por ejemplo con: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambiar-esto-por-una-clave-random-larga

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=600

# Dominio del frontend desplegado (para CORS). En local se permite localhost:4200 igual.
FRONTEND_URL=http://localhost:4200
